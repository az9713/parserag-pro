# ParseRAG — environment variables
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and will never be committed.

# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key — used by the Claude agent for reasoning and tool use
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google API key — used for Gemini embeddings (gemini-embedding-001)
GOOGLE_API_KEY=your-google-api-key-here

# ── Optional — defaults shown ─────────────────────────────────────────────────

# Claude model used by the agent
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Gemini embedding model and output dimension
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=3072

# Path to the Milvus Lite database file
# MILVUS_DB_PATH=./milvus_lite.db

# Maximum number of agent tool calls per query before the loop is terminated
# AGENT_MAX_STEPS=20
